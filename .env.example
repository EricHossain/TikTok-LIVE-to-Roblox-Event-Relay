# Your TikTok handle (without @). Leave blank to run in test-only mode.
TIKTOK_USERNAME=
# Long random string. Must match BridgeConfig.Secret in Roblox.
SHARED_SECRET=change-me-to-something-long-and-random
# Port (Railway/Render set this automatically)
PORT=8080

# Optional Euler Stream key (https://www.eulerstream.com) - more reliable signing
EULER_API_KEY=

# Comment mode: "single" = whole comment must be a username, "prefix" = "!walk username"
COMMENT_MODE=single
COMMENT_PREFIX=!walk
# Seconds before the same TikTok viewer can register a different Roblox name
JOIN_COOLDOWN_SEC=300

# Gift tiers by total diamonds (diamond value x streak count)
TIER_MEDIUM_DIAMONDS=10
TIER_GIANT_DIAMONDS=100
# Check names exist on Roblox before sending them to the game
VALIDATE_ROBLOX_NAMES=true
